---
const { pageTitle, pageDescription } = Astro.props;
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<SEOHead pageTitle={pageTitle} pageDescription={pageDescription} />
	</head>
	<body>
		<header class="site-header">
			<div class="header-inner">
				<div class="header-left">
					<a href="/" class="back-link">← Back</a>
				</div>
				<div class="header-center">
					<h1 class="site-title">Zane Devlin</h1>
					<p class="site-subtitle">(Filmmaking)</p>
				</div>
				<div class="header-right"></div>
				<div class="header-menu">
					<div class="hamburger-wrap">
						<button class="hamburger" id="hamburger">&#9776;</button>
						<div class="hamburger-dropdown" id="hamburgerDropdown">
						<a href="/" class="dropdown-item">Home</a>
						<div class="dropdown-section">
							<button class="dropdown-heading" id="filmmakingToggle">
								Filmmaking
								<span class="dropdown-arrow">&#9662;</span>
							</button>
							<div class="dropdown-subitems" id="filmmakingSubitems">
								<a href="/filmmaking?category=Personal" class="dropdown-subitem">Personal</a>
								<a href="/filmmaking?category=Collaborations" class="dropdown-subitem">Collaborations</a>
							</div>
						</div>
						<a href="/art-design" class="dropdown-item">Art / Design</a>
					</div>
				</div>
			</div>
		</header>
		<main>
			<h1>{pageTitle}</h1>
			<slot />
		</main>
		<Footer />
		<script>
			const btn = document.getElementById('hamburger');
			const menu = document.getElementById('hamburgerDropdown');
			const mobileMq = window.matchMedia('(max-width: 768px)');

			// Hides whatever the open dropdown sits over (the
			// Personal/Collaborations toggle) instead of relying on
			// stacking order to paint over it - some browsers don't stack
			// a fixed/high-z-index element correctly above descendants of
			// Astro's `display: contents` hydration wrapper, which let it
			// show through even at max z-index. See body.menu-open in
			// style.css. No-op on desktop/tablet, where the dropdown
			// doesn't reach far enough down for this to matter.
			const syncMenuOpenClass = () => {
				document.body.classList.toggle('menu-open', mobileMq.matches && menu.classList.contains('open'));
			};

			btn.addEventListener('click', (e) => {
				e.stopPropagation();
				menu.classList.toggle('open');
				syncMenuOpenClass();
			});
			document.addEventListener('click', () => {
				menu.classList.remove('open');
				syncMenuOpenClass();
			});
			mobileMq.addEventListener('change', syncMenuOpenClass);

			const filmmakingToggle = document.getElementById('filmmakingToggle');
			const filmmakingSubitems = document.getElementById('filmmakingSubitems');
			if (filmmakingToggle && filmmakingSubitems) {
				filmmakingToggle.addEventListener('click', (e) => {
					e.stopPropagation();
					filmmakingToggle.classList.toggle('open');
					filmmakingSubitems.classList.toggle('open');
				});
			}
		</script>
	</body>
</html>