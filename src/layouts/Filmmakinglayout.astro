---
const { pageTitle } = Astro.props;
import Footer from '../components/Footer.astro';
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>{pageTitle}</title>
		<link rel="stylesheet" href="/css/style.css" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Rubik+Glitch&family=Chelsea+Market&display=swap" rel="stylesheet">
	</head>
	<body>
		<!-- Custom Header for Filmmaking Page -->
		<header class="site-header">
			<div class="header-inner">
				<div class="header-left"></div>
				<div class="header-center">
					<h1 class="site-title">Zane Devlin</h1>
					<p class="site-subtitle">(Filmmaking)</p>
				</div>
				<div class="header-right"></div>
			</div>
		</header>
		<!-- Filmmaking Page Nav -->
		<nav class="filmmaking-nav">
			<a href="/" class="back-link">← Back</a>
		</nav>
		<main>
			<h1>{pageTitle}</h1>
            <slot />
		</main>
		<Footer /> 
	</body>
</html>