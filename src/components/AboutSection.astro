---
import SoftwareSection from './SoftwareSection.astro';
---

<div class="wave-divider wave-divider--top">
    <svg viewBox="0 0 1440 200" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0,0 C120,160 1320,160 1440,0 L1440,200 L0,200 Z" fill="#BB2523"/>
        <path d="M0,30 C140,175 1300,175 1440,30 L1440,200 L0,200 Z" fill="rgba(43,43,44,0.3)"/>
        <path d="M0,60 C160,185 1280,185 1440,60 L1440,200 L0,200 Z" fill="rgba(43,43,44,0.6)"/>
        <path d="M0,90 C200,192 1240,192 1440,90 L1440,200 L0,200 Z" fill="#2B2B2C"/>
    </svg>
</div>

<section class="about-section">
    <div class="about-inner">
        <div class="about-image">
            <img src="/portrait.jpg" alt="Zane Devlin" class="portrait" loading="lazy" decoding="async" />
        </div>
        <div class="about-text">
            <h2>About Me</h2>
            <p>
                Zane Devlin, a multi-faceted filmmaker based in Brooklyn, New York has been described as
                "lowkey genius" and his work as "raw." Zane seamlessly intertwines various art forms with
                a profound sense of passion and innovation. He consistently challenges perceived limitations,
                proving naysayers wrong with every artistic endeavor and having fun while doing it.
            </p>
            <div class="relocating-note">Currently relocating to Pittsburgh.</div>
        </div>
        <div class="about-contact">
            <div class="contact-label">Contact</div>
            <div>
                Feel free to reach out if you have any questions, comments, or collaboration ideas.<br />
                <a href="mailto:zaneydevlin@gmail.com">zaneydevlin@gmail.com</a>
            </div>
        </div>
    </div>
</section>

<!-- The toolkit follows About Me, and the wave that used to close this
     component moved inside it. The shelf of icons now sits across that
     wave rather than above it, so the two have to be laid out together;
     see .toolkit-shelf in the stylesheet. -->
<SoftwareSection />