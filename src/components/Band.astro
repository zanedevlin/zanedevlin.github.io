---
const { bandTitle } = Astro.props;
---

<div class="full__purple_band">
    <div class="container full__three_column gap__3_rem">
        <div class="span__2_col">
            <h2>{bandTitle}</h2>
            <p>
                <slot />
            </p>
        </div>
        <div
            style="align-self: stretch; background: url('/img/picture_placeholder.png') center / contain no-repeat;"
            aria-hidden="true"
        >
        </div>
    </div>
</div>