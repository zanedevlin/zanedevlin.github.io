---
import ArtDesignLayout from '../Layouts/ArtDesignLayout.astro';
const pageTitle = "Art / Design";
const pageDescription = "Art and design projects by Zane Devlin, including posters, wearable sculpture, digital art, and more.";
---

<ArtDesignLayout pageTitle={pageTitle} pageDescription={pageDescription}>
  <div class="art-design-page">
    <div class="projects-section">
      <h2 class="section-title">Projects</h2>
      <div class="projects-grid">

        <!-- Pinned tile -->
        <a href="/art-design/posters" class="project-card project-card--pinned">
          <div class="project-image project-image--mosaic">
            <div class="pinned-badge">
              <svg class="pinned-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              Pinned
            </div>
            <div class="poster-mosaic">
              <img src="/poster-make-keeley-jump.jpg" alt="" />
              <img src="/poster-vigilante.jpg" alt="" loading="lazy" decoding="async" />
              <img src="/poster-teenage-wasteland-2.jpg" alt="" loading="lazy" decoding="async" />
              <img src="/poster-get-out.jpg" alt="" loading="lazy" decoding="async" />
              <img src="/poster-surreal.jpg" alt="" loading="lazy" decoding="async" />
              <img src="/poster-the-space.jpg" alt="" loading="lazy" decoding="async" />
            </div>
            <div class="album-badge">
              <svg class="album-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="7" width="14" height="14" rx="2"/>
                <path d="M7 7V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-2"/>
              </svg>
              16 photos
            </div>
            <div class="project-overlay"><span class="overlay-view">View Posters</span></div>
          </div>
          <div class="project-content">
            <div class="project-meta">
              <span class="project-type">Graphic Design</span>
            </div>
            <h3>Posters</h3>
          </div>
        </a>

        <a href="/art-design/the-eclipse" class="project-card">
          <div class="project-image">
            <img src="/the-eclipse-room-bar.avif" alt="The Eclipse installed: foam helmets along a plywood bar, with a CRT television behind" loading="lazy" decoding="async" />
            <div class="album-badge">
              <svg class="album-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="7" width="14" height="14" rx="2"/>
                <path d="M7 7V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-2"/>
              </svg>
              14 photos
            </div>
            <div class="project-overlay"><span class="overlay-view">View Exhibition</span></div>
          </div>
          <div class="project-content">
            <div class="project-meta">
              <span class="project-type">Narrative Sculpture / Installation</span>
              <span class="project-date">Spring 2026</span>
            </div>
            <h3>The Eclipse</h3>
          </div>
        </a>

        <a href="/art-design/fireman-project" class="project-card">
          <div class="project-image">
            <img src="/eclipse-cover.jpg" alt="Zane Devlin holding the finished Eclipse helmet at the gallery show" loading="lazy" decoding="async" />
            <div class="album-badge">
              <svg class="album-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="7" width="14" height="14" rx="2"/>
                <path d="M7 7V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-2"/>
              </svg>
              10 photos
            </div>
            <div class="project-overlay"><span class="overlay-view">View Album</span></div>
          </div>
          <div class="project-content">
            <div class="project-meta">
              <span class="project-type">Prop / Costume Fabrication</span>
              <span class="project-date">Spring 2025</span>
            </div>
            <h3>The Fireman Project</h3>
          </div>
        </a>

        <a href="/art-design/italy" class="project-card">
          <div class="project-image">
            <img src="/italy-cover.jpg" alt="Zane Devlin beside the finished Italy work" loading="lazy" decoding="async" />
            <div class="album-badge">
              <svg class="album-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="7" width="14" height="14" rx="2"/>
                <path d="M7 7V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-2"/>
              </svg>
              2 albums
            </div>
            <div class="project-overlay"><span class="overlay-view">View Albums</span></div>
          </div>
          <div class="project-content">
            <div class="project-meta">
              <span class="project-type">Printmaking / Textiles</span>
              <span class="project-date">Fall 2024</span>
            </div>
            <h3>Italy</h3>
          </div>
        </a>

        <a href="/art-design/consuming-trooper" class="project-card">
          <div class="project-image">
            <img src="/consuming-trooper-cover.jpg" alt="Zane Devlin building the Consuming Trooper helmet in the fabrication lab" loading="lazy" decoding="async" />
            <div class="project-overlay"><span class="overlay-view">View Project</span></div>
          </div>
          <div class="project-content">
            <div class="project-meta">
              <span class="project-type">Wearable Sculpture</span>
              <span class="project-date">May 2023</span>
            </div>
            <h3>The Consuming Trooper</h3>
          </div>
        </a>

        <a href="/art-design/lego-alic" class="project-card">
          <div class="project-image">
            <img src="/lego-alic-1.jpg" alt="LEGO ALIC" loading="lazy" decoding="async" />
            <div class="project-overlay"><span class="overlay-view">View Project</span></div>
          </div>
          <div class="project-content">
            <div class="project-meta">
              <span class="project-type">Digital Art</span>
              <span class="project-date">April 2023</span>
            </div>
            <h3>LEGO ALIC</h3>
          </div>
        </a>

        <a href="/art-design/organic-technology" class="project-card">
          <div class="project-image">
            <img src="/organic-technology-1.jpg" alt="Organic Technology" loading="lazy" decoding="async" />
            <div class="project-overlay"><span class="overlay-view">View Project</span></div>
          </div>
          <div class="project-content">
            <div class="project-meta">
              <span class="project-type">Sculpture</span>
              <span class="project-date">March 2023</span>
            </div>
            <h3>Organic Technology</h3>
          </div>
        </a>

      </div>
    </div>
  </div>
</ArtDesignLayout>