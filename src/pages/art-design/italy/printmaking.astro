/* Captions carry the process piece by piece, because almost nothing here
   is a single technique. What is true of the whole series belongs in the
   description below rather than attached to whichever print it happened
   to be written next to.

   The nine versions of the hand and figure share one method, so only the
   first of them is labelled with it; repeating the same label under each
   would say nothing new. Where two prints were made the same way they
   carry the same label, which is what a wall label would do. */
const images = [
  { src: "/italy-print-studio.jpg", caption: "The drying rack in the studio in Rome. The sheet at the front is a sketch of the superhero character developed for my senior comprehensive project or capstone at Allegheny College, etched into a plate with graphite and finished in watercolor." },

  { src: "/italy-print-06.jpg", caption: "One image, printed in many versions. Each combines three processes on a single sheet: the figure and the halftone screen printed, the hand a laser cut paper stencil, and the background a mono relief." },
  "/italy-print-07.jpg",
  { src: "/italy-print-08.jpg", caption: "The version selected as the poster for Make Keeley JUMP., a short film made at Allegheny. This print was exhibited on campus and later framed and given to Mike Keeley." },
  "/italy-print-09.jpg",
  "/italy-print-01.jpg",
  "/italy-print-02.jpg",
  "/italy-print-03.jpg",
  "/italy-print-04.jpg",
  "/italy-print-05.jpg",

  { src: "/italy-print-10.jpg", caption: "A laser cut plastic stencil, printed as a mono relief." },
  { src: "/italy-print-11.jpg", caption: "Screen printed. This is the pattern that was later printed onto fabric, and eventually onto the balaclavas of my senior comprehensive project or capstone at Allegheny College." },
  { src: "/italy-print-12.jpg", caption: "The same pattern, printed in the same sitting, run experimentally on black paper." },
