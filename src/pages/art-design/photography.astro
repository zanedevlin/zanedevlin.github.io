<ArtDesignLayout
  backUrl="/art-design"
  pageTitle="Photography"
  pageDescription="A selection of the best photographs taken by Zane Devlin."
  hideHeaderBack
>
  <div class="project-page">
    <div class="project-title-row">
      <a href="/art-design" class="project-back-link">← Back</a>
      <div class="project-page-title-bar">Photography</div>
    </div>
    <ProjectSlider slides={images} album justified albumOpensViewer client:load />
    <div class="project-page-body">
      <div class="project-meta">
        <span class="project-type">Photography</span>
        <span class="project-date">2023-2025</span>
      </div>
      <p class="project-page-description">A selection of my best photographs, newest first.</p>
    </div>
  </div>
</ArtDesignLayout>
