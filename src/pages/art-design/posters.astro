---
import ArtDesignLayout from '../../Layouts/ArtDesignLayout.astro';
import PostersSlider from '../../components/PostersSlider.jsx';
---

<ArtDesignLayout pageTitle="Posters" backUrl="/art-design" hideHeaderBack>
  <div class="project-page">
    <div class="project-title-row">
      <a href="/art-design" class="project-back-link" id="postersBackLink">← Back</a>
      <div class="project-page-title-bar">Posters</div>
    </div>
    <PostersSlider client:idle />
    <div class="project-page-body">
      <div class="project-meta">
        <span class="project-type">Graphic Design</span>
      </div>
      <p class="project-page-description">A collection of posters created across various projects over the years. Each slide links back to the project it originated from.</p>
    </div>
  </div>
</ArtDesignLayout>